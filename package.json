{
  "name": "specreceipt",
  "version": "0.4.3",
  "description": "Repository-local engineering workflow and evidence toolkit for coding agents",
  "license": "Unlicense",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PutintsevSergii/specreceipt.git"
  },
  "homepage": "https://github.com/PutintsevSergii/specreceipt#readme",
  "bugs": {
    "url": "https://github.com/PutintsevSergii/specreceipt/issues"
  },
  "type": "module",
  "bin": {
    "specreceipt": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "files": [
    "dist/",
    "assets/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/release.mjs sync && tsc && node scripts/build-assets.mjs",
    "version:sync": "node scripts/release.mjs sync",
    "version:check": "node scripts/release.mjs check",
    "test": "node --test tests-node/*.test.mjs",
    "check": "node scripts/release.mjs sync && tsc --noEmit",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "test:upgrade": "node scripts/test-upgrade.mjs",
    "test:e2e": "node scripts/test-codex-e2e.mjs",
    "test:e2e:copilot": "node scripts/test-copilot-e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  }
}
