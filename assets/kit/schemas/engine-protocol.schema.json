{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness subprocess protocol v1",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "target", "argv"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "target": { "type": "string", "minLength": 1 },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "protocolVersion",
        "engineVersion",
        "exitCode",
        "data",
        "error"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "engineVersion": { "type": "string" },
        "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
        "target": { "type": "string" },
        "cwd": { "type": "string" },
        "engineRoot": { "type": "string" },
        "operations": { "type": "array", "items": { "type": "string" } },
        "data": {},
        "error": {
          "type": ["object", "null"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          },
          "required": ["code", "message"]
        }
      }
    }
  },
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/response" }]
}
