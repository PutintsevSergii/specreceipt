{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "investigation",
  "type": "object",
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "task_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1},
    "repository_fingerprint": {"type": "string", "minLength": 64},
    "policy_hash": {"type": "string", "minLength": 1},
    "host_trace": {"type": ["string", "null"]},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["available", "configured_only", "unavailable", "denied", "failed", "irrelevant"]},
          "read_only": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1}
        },
        "required": ["name", "status", "read_only", "reason"],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "criterion": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "category": {"type": ["string", "null"]},
          "result": {"type": "string", "enum": ["AGREE", "CODE_ONLY", "NO_MCP", "CONFLICT", "UNVERIFIED"]},
          "code": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "line": {"type": "integer", "minimum": 1},
                "sha256": {"type": "string", "minLength": 64}
              },
              "required": ["path", "line", "sha256"],
              "additionalProperties": false
            }
          },
          "mcp": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tool": {"type": "string", "minLength": 1},
                "resource": {"type": "string", "minLength": 1},
                "revision": {"type": ["string", "null"]},
                "observed_at": {"type": "string", "minLength": 1},
                "summary": {"type": "string", "minLength": 1},
                "status": {"type": "string", "enum": ["success", "denied", "failed", "unavailable"]}
              },
              "required": ["tool", "resource", "revision", "observed_at", "summary", "status"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "criterion", "summary", "category", "result", "code", "mcp"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "task_id", "question", "definition", "repository_fingerprint", "policy_hash", "host_trace", "tools", "claims"],
  "additionalProperties": false
}
