{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graph",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "provider_version": {
      "type": "string",
      "minLength": 1
    },
    "config_hash": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "complete"
      ]
    },
    "coverage": {
      "type": "string",
      "enum": [
        "partial"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "indexed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "nodes",
          "edges",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "last_update": {
      "type": "object",
      "properties": {
        "reindexed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deleted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "reindexed",
        "deleted"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "provider",
    "provider_version",
    "config_hash",
    "status",
    "coverage",
    "limitations",
    "updated_at",
    "indexed_paths",
    "hashes",
    "files",
    "last_update"
  ],
  "additionalProperties": false
}
