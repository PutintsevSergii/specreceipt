{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "checks",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "stack_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "builtin",
              "command"
            ]
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "approved": {
            "type": "boolean"
          },
          "approval_reference": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "report_format": {
            "type": "string",
            "enum": [
              "junit-v1"
            ]
          },
          "input_contract": {
            "type": "object",
            "properties": {
              "schema_version": {
                "type": "integer",
                "enum": [
                  1
                ]
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "independent": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "approval_reference": {
                "type": "string",
                "minLength": 1
              },
              "approval_hash": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_revision": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "schema_version",
              "inputs",
              "independent",
              "rationale",
              "approval_reference",
              "approval_hash",
              "reviewed_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "kind",
          "argv",
          "timeout_seconds",
          "approved",
          "approval_reference",
          "purpose"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "stack_revision",
    "checks"
  ],
  "additionalProperties": false
}
